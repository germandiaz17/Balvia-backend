# ──────────────────────────────────────────────────────────────────────────
# Balvia Backend — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER put real credentials in this file (.env.example IS committed).
# ──────────────────────────────────────────────────────────────────────────

# Application
# NOTE: keep these without inline comments — the Makefile exports .env to `go run`
# and trailing text/space would leak into the value.
# APP_ENV: development | staging | production
APP_ENV=development
# APP_PORT: HTTP port the API listens on
APP_PORT=8080
# LOG_LEVEL: trace | debug | info | warn | error
LOG_LEVEL=debug

# Auth — secret that signs JWT access tokens. Generate a strong random value,
# e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Database (Neon / PostgreSQL) — Neon requires SSL (sslmode=require).
#
# DATABASE_URL: the app runtime connection. Use Neon's POOLED endpoint
# (host contains "-pooler"). pgx supports channel_binding, so keep it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# MIGRATE_DATABASE_URL: used ONLY by golang-migrate (Makefile migrate-* targets).
# Must be the DIRECT endpoint (remove "-pooler" from the host) and must NOT
# include channel_binding — golang-migrate uses lib/pq, which needs a session
# connection for advisory locks and doesn't understand channel_binding.
MIGRATE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
